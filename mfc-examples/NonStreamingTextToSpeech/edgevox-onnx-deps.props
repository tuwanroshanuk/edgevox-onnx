<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ImportGroup Label="PropertySheets" />
  <PropertyGroup Label="UserMacros" />
  <PropertyGroup>
    <EdgevoxOnnxBuildDirectory>..\..\build</EdgevoxOnnxBuildDirectory>
    <EdgevoxOnnxInstallDirectory>..\..\build\install</EdgevoxOnnxInstallDirectory>
    <EdgevoxOnnxLibraries>
        edgevox-onnx-portaudio_static.lib;
        edgevox-onnx-c-api.lib;
        edgevox-onnx-core.lib;
        kaldi-decoder-core.lib;
        edgevox-onnx-kaldifst-core.lib;
        edgevox-onnx-fstfar.lib;
        edgevox-onnx-fst.lib;
        kaldi-native-fbank-core.lib;
        kissfft-float.lib;
        onnxruntime.lib;
        piper_phonemize.lib;
        espeak-ng.lib;
        ucd.lib;
        ssentencepiece_core.lib;
    </EdgevoxOnnxLibraries>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>
	  $(EdgevoxOnnxBuildDirectory)\_deps\portaudio-src\include;
    $(EdgevoxOnnxInstallDirectory)\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <AdditionalLibraryDirectories>$(EdgevoxOnnxInstallDirectory)\lib;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>$(EdgevoxOnnxLibraries);</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
  <ItemGroup />
</Project>
