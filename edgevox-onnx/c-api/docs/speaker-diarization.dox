/**
@page speaker_diarization Offline Speaker Diarization

edgevox-onnx supports offline speaker diarization through the
@ref EdgevoxOnnxCreateOfflineSpeakerDiarization() API. It combines a
segmentation model, a speaker embedding extractor, and a clustering
algorithm.

@see EdgevoxOnnxCreateOfflineSpeakerDiarization,
     EdgevoxOnnxOfflineSpeakerDiarizationConfig

@code
EdgevoxOnnxOfflineSpeakerDiarizationConfig config;
memset(&config, 0, sizeof(config));
config.segmentation.pyannote.model =
    "./sherpa-onnx-pyannote-segmentation-3-0/model.onnx";
config.embedding.model =
    "./3dspeaker_speech_eres2net_base_sv_zh-cn_3dspeaker_16k.onnx";
config.clustering.num_clusters = 4;

const EdgevoxOnnxOfflineSpeakerDiarization *sd =
    EdgevoxOnnxCreateOfflineSpeakerDiarization(&config);

const EdgevoxOnnxWave *wave = EdgevoxOnnxReadWave("./meeting.wav");
const EdgevoxOnnxOfflineSpeakerDiarizationResult *result =
    EdgevoxOnnxOfflineSpeakerDiarizationProcess(sd, wave->samples,
                                               wave->num_samples);

const EdgevoxOnnxOfflineSpeakerDiarizationSegment *segments =
    EdgevoxOnnxOfflineSpeakerDiarizationResultSortByStartTime(result);
int32_t n = EdgevoxOnnxOfflineSpeakerDiarizationResultGetNumSegments(result);
for (int32_t i = 0; i < n; ++i) {
  printf("Speaker %d: %.2f - %.2f\n", segments[i].speaker,
         segments[i].start, segments[i].end);
}

EdgevoxOnnxOfflineSpeakerDiarizationDestroySegment(segments);
EdgevoxOnnxOfflineSpeakerDiarizationDestroyResult(result);
EdgevoxOnnxFreeWave(wave);
EdgevoxOnnxDestroyOfflineSpeakerDiarization(sd);
@endcode

Segmentation model: `sherpa-onnx-pyannote-segmentation-3-0/model.onnx`

Embedding model: `3dspeaker_speech_eres2net_base_sv_zh-cn_3dspeaker_16k.onnx`

Example source: [offline-speaker-diarization-c-api.c](https://github.com/k2-fsa/sherpa-onnx/blob/master/c-api-examples/offline-speaker-diarization-c-api.c)
*/
