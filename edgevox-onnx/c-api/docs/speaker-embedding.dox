/**
@page speaker_embedding Speaker Embedding Extraction and Management

edgevox-onnx provides speaker embedding extraction via
@ref EdgevoxOnnxCreateSpeakerEmbeddingExtractor() and speaker
enrollment/search/verification via
@ref EdgevoxOnnxCreateSpeakerEmbeddingManager().

@see EdgevoxOnnxCreateSpeakerEmbeddingExtractor,
     EdgevoxOnnxSpeakerEmbeddingExtractorConfig,
     EdgevoxOnnxCreateSpeakerEmbeddingManager

@code
EdgevoxOnnxSpeakerEmbeddingExtractorConfig config;
memset(&config, 0, sizeof(config));
config.model = "./3dspeaker_speech_campplus_sv_zh-cn_16k-common.onnx";
config.num_threads = 1;
config.provider = "cpu";

const EdgevoxOnnxSpeakerEmbeddingExtractor *extractor =
    EdgevoxOnnxCreateSpeakerEmbeddingExtractor(&config);

int32_t dim = EdgevoxOnnxSpeakerEmbeddingExtractorDim(extractor);
const EdgevoxOnnxSpeakerEmbeddingManager *manager =
    EdgevoxOnnxCreateSpeakerEmbeddingManager(dim);

// Enroll a speaker
const float *embedding = /* compute from audio */;
EdgevoxOnnxSpeakerEmbeddingManagerAdd(manager, "alice", embedding);
EdgevoxOnnxSpeakerEmbeddingExtractorDestroyEmbedding(embedding);

// Search for a speaker
const float *query = /* compute from test audio */;
const char *name = EdgevoxOnnxSpeakerEmbeddingManagerSearch(
    manager, query, 0.5f);
if (name) {
  printf("Identified: %s\n", name);
  EdgevoxOnnxSpeakerEmbeddingManagerFreeSearch(name);
}
EdgevoxOnnxSpeakerEmbeddingExtractorDestroyEmbedding(query);

EdgevoxOnnxDestroySpeakerEmbeddingManager(manager);
EdgevoxOnnxDestroySpeakerEmbeddingExtractor(extractor);
@endcode

Model file: `3dspeaker_speech_campplus_sv_zh-cn_16k-common.onnx`

Example source: [speaker-identification-c-api.c](https://github.com/k2-fsa/edgevox-onnx/blob/master/c-api-examples/speaker-identification-c-api.c)
*/
