name: Publish Rust Crates

on:
  push:
    branches:
      - release
      - release-rust

  workflow_dispatch:

jobs:
  publish:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions-rust-lang/setup-rust-toolchain@v1
        with:
          toolchain: stable

      - name: Update version
        shell: bash
        run: |
          ./new-release.sh
          git diff .

      - name: Update
        shell: bash
        run: |
          cd edgevox-onnx/rust
          ./publish.sh

      - name: Login to crates.io
        run: cargo login ${{ secrets.CARGO_REGISTRY_TOKEN }}

      - name: Publish edgevox-onnx-sys
        shell: bash
        env:
          CARGO_REGISTRY_TOKEN: ${{ secrets.CARGO_REGISTRY_TOKEN }}
        run: |
          cargo publish --allow-dirty --manifest-path=edgevox-onnx/rust/edgevox-onnx-sys/Cargo.toml
          sleep 30  # Wait for crates.io to index

      - name: Publish edgevox-onnx
        shell: bash
        env:
          CARGO_REGISTRY_TOKEN: ${{ secrets.CARGO_REGISTRY_TOKEN }}
        run: |
          cargo publish --allow-dirty --manifest-path=edgevox-onnx/rust/edgevox-onnx/Cargo.toml
