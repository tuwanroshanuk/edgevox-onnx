name: jar

on:
  push:
    branches:
      - refactor-jar-2
    tags:
      - 'v[0-9]+.[0-9]+.[0-9]+*'

  workflow_dispatch:

concurrency:
  group: jar-${{ github.ref }}
  cancel-in-progress: true

permissions:
  contents: write
jobs:
  jar:
    runs-on: ${{ matrix.os }}
    name: ${{ matrix.os }} ${{ matrix.arch }}
    strategy:
      fail-fast: false
      matrix:
        include:
          - os: ubuntu-24.04-arm
            arch: "arm64"

          - os: ubuntu-latest
            arch: "x64"

          - os: macos-latest
            arch: "arm64"

          - os: macos-15-intel
            arch: "x64"

          - os: windows-2022
            arch: "x64"

    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - uses: actions/setup-java@v4
        with:
          distribution: 'temurin' # See 'Supported distributions' for available options
          java-version: '21'

      - name: Show java version
        shell: bash
        run: |
          java --version

      - name: Download libs ${{ matrix.os }} ${{ matrix.arch }}
        if: ${{ matrix.os == 'ubuntu-24.04-arm' && matrix.arch == 'arm64' }}
        shell: bash
        run: |
          EDGEVOX_ONNX_VERSION=$(grep "EDGEVOX_ONNX_VERSION" ./CMakeLists.txt  | cut -d " " -f 2  | cut -d '"' -f 2)
          curl -SL -O https://github.com/k2-fsa/sherpa-onnx/releases/download/v$SHERPA_ONNX_VERSION/sherpa-onnx-v$SHERPA_ONNX_VERSION-linux-aarch64-jni.tar.bz2
          tar xvf ./*.tar.bz2

          src=edgevox-onnx-v$EDGEVOX_ONNX_VERSION-linux-aarch64-jni
          dst=edgevox-onnx/java-api/resources/edgevox-onnx/native/linux-aarch64

          mkdir -p $dst
          cp -v $src/lib/libedgevox-onnx-jni.so $dst/
          cp -v $src/lib/libonnxruntime.so $dst/

          ls -lh $dst
          rm -rf $src*

      - name: Download libs ubuntu-latest x64
        if: ${{ matrix.os == 'ubuntu-latest' && matrix.arch == 'x64' }}
        shell: bash
        run: |
          EDGEVOX_ONNX_VERSION=$(grep "EDGEVOX_ONNX_VERSION" ./CMakeLists.txt  | cut -d " " -f 2  | cut -d '"' -f 2)
          curl -SL -O https://github.com/k2-fsa/sherpa-onnx/releases/download/v$SHERPA_ONNX_VERSION/sherpa-onnx-v$SHERPA_ONNX_VERSION-linux-x64-jni.tar.bz2
          tar xvf ./*.tar.bz2

          src=edgevox-onnx-v$EDGEVOX_ONNX_VERSION-linux-x64-jni
          dst=edgevox-onnx/java-api/resources/edgevox-onnx/native/linux-x64

          mkdir -p $dst
          cp -v $src/lib/libedgevox-onnx-jni.so $dst/
          cp -v $src/lib/libonnxruntime.so $dst/

          ls -lh $dst
          rm -rf $src*

      - name: Download libs macos-latest arm64
        if: ${{ matrix.os == 'macos-latest' && matrix.arch == 'arm64' }}
        shell: bash
        run: |
          EDGEVOX_ONNX_VERSION=$(grep "EDGEVOX_ONNX_VERSION" ./CMakeLists.txt  | cut -d " " -f 2  | cut -d '"' -f 2)
          curl -SL -O https://github.com/k2-fsa/sherpa-onnx/releases/download/v$SHERPA_ONNX_VERSION/sherpa-onnx-v$SHERPA_ONNX_VERSION-osx-arm64-jni.tar.bz2
          tar xvf ./*.tar.bz2

          src=edgevox-onnx-v$EDGEVOX_ONNX_VERSION-osx-arm64-jni
          dst=edgevox-onnx/java-api/resources/edgevox-onnx/native/osx-aarch64

          mkdir -p $dst
          cp -v $src/lib/libonnxruntime.1.27.0.dylib $dst/
          cp -v $src/lib/libedgevox-onnx-jni.dylib $dst/

          ls -lh $dst
          rm -rf $src*

      - name: Download libs macos-15-intel x64
        if: ${{ matrix.os == 'macos-15-intel' && matrix.arch == 'x64' }}
        shell: bash
        run: |
          EDGEVOX_ONNX_VERSION=$(grep "EDGEVOX_ONNX_VERSION" ./CMakeLists.txt  | cut -d " " -f 2  | cut -d '"' -f 2)
          curl -SL -O https://github.com/k2-fsa/sherpa-onnx/releases/download/v$SHERPA_ONNX_VERSION/sherpa-onnx-v$SHERPA_ONNX_VERSION-osx-x86_64-jni.tar.bz2
          tar xvf ./*.tar.bz2

          src=edgevox-onnx-v$EDGEVOX_ONNX_VERSION-osx-x86_64-jni
          dst=edgevox-onnx/java-api/resources/edgevox-onnx/native/osx-x64

          mkdir -p $dst
          cp -v $src/lib/libonnxruntime.1.27.0.dylib $dst/
          cp -v $src/lib/libedgevox-onnx-jni.dylib $dst/

          ls -lh $dst
          rm -rf $src*

      - name: Download libs windows-2022 x64
        if: ${{ matrix.os == 'windows-2022' && matrix.arch == 'x64' }}
        shell: bash
        run: |
          EDGEVOX_ONNX_VERSION=$(grep "EDGEVOX_ONNX_VERSION" ./CMakeLists.txt  | cut -d " " -f 2  | cut -d '"' -f 2)
          curl -SL -O https://github.com/k2-fsa/sherpa-onnx/releases/download/v$SHERPA_ONNX_VERSION/sherpa-onnx-v$SHERPA_ONNX_VERSION-win-x64-jni.tar.bz2
          tar xvf ./*.tar.bz2

          src=edgevox-onnx-v$EDGEVOX_ONNX_VERSION-win-x64-jni
          ls -lh $src
          ls -lh $src/lib
          dst=edgevox-onnx/java-api/resources/edgevox-onnx/native/win-x64

          mkdir -p $dst
          cp -v $src/lib/onnxruntime.dll $dst/
          cp -v $src/lib/edgevox-onnx-jni.dll $dst/

          ls -lh $dst
          rm -rf $src*

      - name: Create java jar (source code)
        shell: bash
        run: |
          cd edgevox-onnx/java-api
          mvn package

          ls -lh target/*.jar

      - name: Create java jar (native lib)
        shell: bash
        run: |
          EDGEVOX_ONNX_VERSION=$(grep "EDGEVOX_ONNX_VERSION" ./CMakeLists.txt  | cut -d " " -f 2  | cut -d '"' -f 2)

          cd edgevox-onnx/java-api

          ls -lh resources/edgevox-onnx/native

          echo "--"

          ls -lh resources/edgevox-onnx/native/*/

          jar cfv ./edgevox-onnx-native.jar -C ./resources .

          ls -lh *.jar

          os=${{ matrix.os }}
          arch=${{ matrix.arch }}

          if [[ $os == "ubuntu-24.04-arm" && $arch == "arm64" ]]; then
            mv -v edgevox-onnx-native.jar edgevox-onnx-native-lib-linux-aarch64-$EDGEVOX_ONNX_VERSION.jar
          elif [[ $os == "ubuntu-latest" && $arch == "x64" ]]; then
            mv -v edgevox-onnx-native.jar edgevox-onnx-native-lib-linux-x64-$EDGEVOX_ONNX_VERSION.jar
          elif [[ $os == "macos-latest" && $arch == "arm64" ]]; then
            mv -v edgevox-onnx-native.jar edgevox-onnx-native-lib-osx-aarch64-$EDGEVOX_ONNX_VERSION.jar
          elif [[ $os == "macos-15-intel" && $arch == "x64" ]]; then
            mv -v edgevox-onnx-native.jar edgevox-onnx-native-lib-osx-x64-$EDGEVOX_ONNX_VERSION.jar
          elif [[ $os == "windows-2022" && $arch == "x64" ]]; then
            mv -v edgevox-onnx-native.jar edgevox-onnx-native-lib-win-x64-$EDGEVOX_ONNX_VERSION.jar
          else
            echo "Unknown os $os with arch $arch"
          fi

      - name: Show java jar (source code)
        shell: bash
        run: |
          EDGEVOX_ONNX_VERSION=$(grep "EDGEVOX_ONNX_VERSION" ./CMakeLists.txt  | cut -d " " -f 2  | cut -d '"' -f 2)

          cd edgevox-onnx/java-api

          unzip -l target/edgevox-onnx-jvm-$EDGEVOX_ONNX_VERSION.jar

          cp -v target/edgevox-onnx-jvm-$EDGEVOX_ONNX_VERSION.jar ./edgevox-onnx-jvm-$EDGEVOX_ONNX_VERSION.jar

          ls -lh *.jar

          unzip -l ./edgevox-onnx-jvm-$EDGEVOX_ONNX_VERSION.jar

      - name: Show java jar (native lib)
        shell: bash
        run: |
          cd edgevox-onnx/java-api

          ls -lh *.jar

          unzip -l edgevox-onnx-jvm*.jar
          echo "---"
          unzip -l edgevox-onnx-native*.jar

      - name: Release jar
        if: github.repository_owner == 'k2-fsa' && github.event_name == 'push' && contains(github.ref, 'refs/tags/')
        uses: svenstaro/upload-release-action@v2
        with:
          file_glob: true
          overwrite: true
          file: ./edgevox-onnx/java-api/edgevox-onnx-native*.jar

      - name: Release jar
        if: github.repository_owner == 'csukuangfj' && github.event_name == 'push' && contains(github.ref, 'refs/tags/')
        uses: svenstaro/upload-release-action@v2
        with:
          file_glob: true
          overwrite: true
          file: ./edgevox-onnx/java-api/edgevox-onnx-native*.jar
          repo_name: k2-fsa/sherpa-onnx
          repo_token: ${{ secrets.UPLOAD_GH_EDGEVOX_ONNX_TOKEN }}
          tag: v1.13.4

      - name: Release jar
        if: github.repository_owner == 'k2-fsa' && github.event_name == 'push' && contains(github.ref, 'refs/tags/') && matrix.os == 'ubuntu-24.04-arm'
        uses: svenstaro/upload-release-action@v2
        with:
          file_glob: true
          overwrite: true
          file: ./edgevox-onnx/java-api/edgevox-onnx-jvm*.jar

      - name: Release jar
        if: github.repository_owner == 'csukuangfj' && github.event_name == 'push' && contains(github.ref, 'refs/tags/') && matrix.os == 'ubuntu-24.04-arm'
        uses: svenstaro/upload-release-action@v2
        with:
          file_glob: true
          overwrite: true
          file: ./edgevox-onnx/java-api/edgevox-onnx-jvm*.jar
          repo_name: k2-fsa/sherpa-onnx
          repo_token: ${{ secrets.UPLOAD_GH_EDGEVOX_ONNX_TOKEN }}
          tag: v1.13.4

      - name: Test KittenTTS
        if: ${{ !startsWith(github.ref, 'refs/tags/') }}
        shell: bash
        run: |
          EDGEVOX_ONNX_VERSION=$(grep "EDGEVOX_ONNX_VERSION" ./CMakeLists.txt  | cut -d " " -f 2  | cut -d '"' -f 2)

          os=${{ matrix.os }}
          arch=${{ matrix.arch }}

          if [[ $os == "ubuntu-24.04-arm" && $arch == "arm64" ]]; then
            native_jar=edgevox-onnx-native-lib-linux-aarch64-$EDGEVOX_ONNX_VERSION.jar
          elif [[ $os == "ubuntu-latest" && $arch == "x64" ]]; then
            native_jar=edgevox-onnx-native-lib-linux-x64-$EDGEVOX_ONNX_VERSION.jar
          elif [[ $os == "macos-latest" && $arch == "arm64" ]]; then
            native_jar=edgevox-onnx-native-lib-osx-aarch64-$EDGEVOX_ONNX_VERSION.jar
          elif [[ $os == "macos-15-intel" && $arch == "x64" ]]; then
            native_jar=edgevox-onnx-native-lib-osx-x64-$EDGEVOX_ONNX_VERSION.jar
          elif [[ $os == "windows-2022" && $arch == "x64" ]]; then
            native_jar=edgevox-onnx-native-lib-win-x64-$EDGEVOX_ONNX_VERSION.jar
          else
            echo "Unknown os $os with arch $arch"
          fi

          echo "native_jar: $native_jar"
          ls -lh edgevox-onnx/java-api/$native_jar

          if [[ ${{ matrix.os }} == "windows-2022" ]]; then
            SEP=";"
          else
            SEP=":"
          fi
          cd java-api-examples

          curl -SL -O https://github.com/k2-fsa/sherpa-onnx/releases/download/tts-models/kitten-nano-en-v0_1-fp16.tar.bz2
          tar xf kitten-nano-en-v0_1-fp16.tar.bz2
          rm kitten-nano-en-v0_1-fp16.tar.bz2

          java \
            -cp "../edgevox-onnx/java-api/target/edgevox-onnx-jvm-$EDGEVOX_ONNX_VERSION.jar${SEP}../edgevox-onnx/java-api/$native_jar" \
            NonStreamingTtsKittenEn.java
