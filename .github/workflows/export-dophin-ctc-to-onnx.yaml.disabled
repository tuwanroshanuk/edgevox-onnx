name: export-dolphin-ctc-to-onnx

on:
  workflow_dispatch:

concurrency:
  group: export-dolphin-ctc-to-onnx-${{ github.ref }}
  cancel-in-progress: true

jobs:
  export-dolphin-ctc-to-onnx:
    if: github.repository_owner == 'k2-fsa' || github.repository_owner == 'csukuangfj'
    name: ${{ matrix.model_type }}
    runs-on: ${{ matrix.os }}
    strategy:
      fail-fast: false
      matrix:
        os: [macos-latest]
        model_type: [small, base]

    steps:
      - uses: actions/checkout@v4

      - name: Download ${{ matrix.model_type }}
        shell: bash
        run: |
          git lfs install
          type=${{ matrix.model_type }}

          git clone https://huggingface.co/csukuangfj/edgevox-onnx-dolphin-$type-ctc-multi-lang-int8-2025-04-02
          git clone https://huggingface.co/csukuangfj/edgevox-onnx-dolphin-$type-ctc-multi-lang-2025-04-02

          rm -rf edgevox-onnx-dolphin-*/.git*

          ls -lha edgevox-onnx-dolphin-*/

          tar cjfv edgevox-onnx-dolphin-$type-ctc-multi-lang-int8-2025-04-02.tar.bz2 edgevox-onnx-dolphin-$type-ctc-multi-lang-int8-2025-04-02
          tar cjfv edgevox-onnx-dolphin-$type-ctc-multi-lang-2025-04-02.tar.bz2 edgevox-onnx-dolphin-$type-ctc-multi-lang-2025-04-02

      - name: Release
        uses: svenstaro/upload-release-action@v2
        with:
          file_glob: true
          file: ./*.tar.bz2
          overwrite: true
          repo_name: k2-fsa/edgevox-onnx
          repo_token: ${{ secrets.UPLOAD_GH_EDGEVOX_ONNX_TOKEN }}
          tag: asr-models
